# Copy to .env (npm run setup does it) and fill in what you use. .env is git-ignored.

# Model provider: claude-cli (default, your Claude subscription via the Claude Code CLI) or gemini.
# LLM_PROVIDER=claude-cli

# claude-cli: path to the claude binary if it is not on PATH.
# CLAUDE_BIN=

# gemini: either an API key from Google AI Studio...
# GEMINI_API_KEY=
# ...or Vertex AI with gcloud application-default credentials.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# Optional per-run model overrides (provider model names, e.g. sonnet / opus / haiku for claude-cli).
# FIELD_MODEL=
# AGENT_MODEL=

# Dashboard port (default 4321).
# UI_PORT=4321
